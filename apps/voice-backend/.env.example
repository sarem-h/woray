# ============================================================================
# 1. ACTIVE PIPELINE SELECTORS (Explicit Plug-and-Play Registry)
# ============================================================================
# STT Provider: deepgram | openai
VOICE_STT_PROVIDER=deepgram
DEEPGRAM_STT_MODEL=nova-2-conversationalai

# LLM Provider: bedrock | openai | google
VOICE_LLM_PROVIDER=bedrock
BEDROCK_MODEL_ID=us.anthropic.claude-3-5-haiku-20241022-v1:0
AWS_REGION=us-east-1

# TTS Provider: deepgram | cartesia | elevenlabs | openai
# ('deepgram' uses Deepgram Aura with your existing DEEPGRAM_API_KEY; switch to 'cartesia' once CARTESIA_API_KEY is added)
VOICE_TTS_PROVIDER=deepgram
DEEPGRAM_TTS_VOICE=aura-asteria-en
CARTESIA_VOICE_ID=a0e99841-438c-4a64-b679-ae501e7d6091

# ============================================================================
# 2. INFRASTRUCTURE & PROVIDER CREDENTIALS
# ============================================================================
PORT=3001
LIVEKIT_URL=wss://your_project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Deepgram (Powers Nova-2 STT + Aura TTS)
DEEPGRAM_API_KEY=your_deepgram_api_key

# AWS Bedrock (Bearer Token API Key)
AWS_BEARER_TOKEN_BEDROCK=your_bedrock_bearer_token

# Optional Secondary Providers (Only validated if selected above)
CARTESIA_API_KEY=your_cartesia_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key
OPENAI_API_KEY=your_openai_api_key
GOOGLE_API_KEY=your_gemini_api_key


# LiveKit Agent Worker name (must match RoomAgentDispatch.agentName in server.ts)
LIVEKIT_AGENT_NAME=woray-agent
