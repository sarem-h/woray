# LiveKit Cloud or Self-Hosted Instance Configuration
LIVEKIT_URL=wss://your-livekit-project.livekit.cloud
LIVEKIT_API_KEY=devkey_or_api_key
LIVEKIT_API_SECRET=secret_or_api_secret

# Voice Backend Server Port
PORT=3001

# AI Model Provider Credentials
# Speech-to-Text (STT)
DEEPGRAM_API_KEY=your_deepgram_api_key

# Large Language Model (LLM) & OpenAI STT/TTS
OPENAI_API_KEY=your_openai_api_key

# Ultra-Low Latency Text-to-Speech (TTS)
CARTESIA_API_KEY=your_cartesia_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Optional: Google Gemini LLM
GOOGLE_API_KEY=your_gemini_api_key
