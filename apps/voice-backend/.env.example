# ============================================================================
# WORAY VOICE BACKEND — SECRETS ONLY
# ============================================================================
# Behavior config (models, voices, temperatures, prompts) lives in:
#   apps/voice-backend/src/config/pipeline.config.ts
#   apps/voice-backend/src/config/prompts.ts
# Only secrets go here. This file is gitignored.
# ============================================================================

# --- LiveKit (required) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# --- Deepgram (required — powers STT and Aura TTS) ---
DEEPGRAM_API_KEY=your_deepgram_api_key

# --- AWS Bedrock (required — bearer token for Claude) ---
AWS_BEARER_TOKEN_BEDROCK=your_bedrock_bearer_token

# --- Optional providers (only needed if selected in pipeline.config.ts) ---
CARTESIA_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
ELEVENLABS_API_KEY=
